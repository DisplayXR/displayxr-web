{
  "manifest_version": 3,
  "name": "DisplayXR Immersive VR",
  "version": "0.3.18",
  "description": "Serves WebXR immersive-vr sessions in the browser tab through the DisplayXR inline-3d path. Built into the DisplayXR Browser as a component extension; the page needs no changes.",
  "key": "",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
