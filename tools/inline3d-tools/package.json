{
  "name": "@displayxr/inline3d-tools",
  "version": "0.1.2",
  "description": "Agent-agnostic tools for @displayxr/inline3d pages: a headless checker (fake DisplayXR Browser + plain 2D run), a glTF/GLB asset check, page scaffolds, optional asset generation with provenance, and a stdio MCP server exposing the same operations.",
  "type": "module",
  "bin": {
    "inline3d-tools": "./bin/inline3d-tools.mjs"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "lib/",
    "templates/",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "keywords": [
    "displayxr",
    "inline-3d",
    "spatial-display",
    "3d-display",
    "mcp",
    "model-context-protocol",
    "agent",
    "gltf",
    "checker"
  ],
  "homepage": "https://github.com/DisplayXR/displayxr-web/tree/main/tools/inline3d-tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DisplayXR/displayxr-web.git",
    "directory": "tools/inline3d-tools"
  },
  "bugs": {
    "url": "https://github.com/DisplayXR/displayxr-web/issues"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
