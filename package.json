{
  "name": "@displayxr/inline3d",
  "version": "1.12.1",
  "description": "Turn any HTML <canvas> into a glasses-free-3D window on a DisplayXR display, inside an ordinary web page. Dependency-free; progressive enhancement (falls back to plain 2D everywhere else).",
  "type": "module",
  "types": "./index.d.ts",
  "main": "./js/inline3d.js",
  "module": "./js/inline3d.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./js/inline3d.js"
    },
    "./three": {
      "types": "./three.d.ts",
      "import": "./js/inline3d-three.js"
    },
    "./viewer": {
      "types": "./viewer.d.ts",
      "import": "./js/inline3d-viewer.js"
    },
    "./splat": {
      "types": "./splat.d.ts",
      "import": "./js/inline3d-splat.js"
    },
    "./model": {
      "types": "./model.d.ts",
      "import": "./js/inline3d-model-entry.js"
    },
    "./model/three": {
      "types": "./model.d.ts",
      "import": "./js/inline3d-model.js"
    },
    "./package.json": "./package.json",
    "./undock": {
      "types": "./index.d.ts",
      "import": "./js/inline3d-undock.js"
    }
  },
  "sideEffects": false,
  "files": [
    "js/inline3d.js",
    "js/inline3d-undock.js",
    "js/inline3d-mode-switch.js",
    "js/inline3d-three.js",
    "js/inline3d-viewer.js",
    "js/inline3d-splat.js",
    "js/inline3d-sog.js",
    "js/inline3d-splat-perf.js",
    "js/inline3d-splat-rig.js",
    "js/inline3d-splat-playcanvas.js",
    "js/inline3d-splat-shared.js",
    "js/inline3d-model.js",
    "js/inline3d-model-entry.js",
    "js/inline3d-model-playcanvas.js",
    "js/inline3d-playcanvas-engine.js",
    "index.d.ts",
    "three.d.ts",
    "viewer.d.ts",
    "splat.d.ts",
    "model.d.ts",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "displayxr",
    "webxr",
    "inline-3d",
    "glasses-free-3d",
    "stereo",
    "3d-display",
    "lightfield",
    "three",
    "playcanvas"
  ],
  "homepage": "https://displayxr.github.io/displayxr-web/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DisplayXR/displayxr-web.git"
  },
  "bugs": {
    "url": "https://github.com/DisplayXR/displayxr-browser/issues"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "three": ">=0.150.0",
    "@sparkjsdev/spark": ">=2.0.0",
    "playcanvas": ">=2.22.3 <3",
    "meshoptimizer": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    },
    "@sparkjsdev/spark": {
      "optional": true
    },
    "playcanvas": {
      "optional": true
    },
    "meshoptimizer": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc --noEmit -p tsconfig.json && node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/webxr": "^0.5.0"
  }
}
