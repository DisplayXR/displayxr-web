node_modules/
.DS_Store
Thumbs.db

# Local secrets / env files — this repo is public; never commit these.
# Publishing auth comes from CI (OIDC), so no token should ever live on disk.
.env
.env.*
!.env.example

# local test artifacts, never committed
_scratch/

# Wrangler local state (signaling/ deploys)
.wrangler/

# The CDN bundle (dist/call.js, dist/lift.js) is BUILT, not committed: `npm run build:dist`, and
# `prepack` builds it into every published tarball (jsDelivr serves it from npm).
/dist/

# No lockfile: CI installs the two dev tools with --no-save (see .github/workflows); a local
# `npm install` writes one that must not be committed.
package-lock.json
# Exception: the agent tools package has real (pinned) dependencies; its CI and publish workflows
# install them with `npm ci` from this lockfile. npm never publishes a lockfile.
!tools/inline3d-tools/package-lock.json

# Bundler smoke tests (test/bundlers): installed tools and build output, never committed
test/bundlers/node_modules/
test/bundlers/out/

# Panel e2e run output (test/e2e/samples-panel.e2e.mjs): screenshots, logs, results
test/e2e/out/
# The hosted connector has real (pinned) dependencies too: its CI installs them with `npm ci`.
!services/inline3d-mcp/package-lock.json
services/inline3d-mcp/.vercel/

# built-in "Convert to 3D" bundle output (tools/lift-builtin/build.mjs)
lift-sdk/
tools/lift-builtin/test/_out/
