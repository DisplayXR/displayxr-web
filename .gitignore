node_modules/
.DS_Store
Thumbs.db

# Local secrets / env files — this repo is public; never commit these.
# Publishing auth comes from CI (OIDC), so no token should ever live on disk.
.env
.env.*
!.env.example

# local test artifacts, never committed
_scratch/

# Wrangler local state (signaling/ deploys)
.wrangler/

# The CDN bundle (dist/call.js, dist/lift.js) is BUILT, not committed: `npm run build:dist`, and
# `prepack` builds it into every published tarball (jsDelivr serves it from npm).
/dist/

# No lockfile: CI installs the two dev tools with --no-save (see .github/workflows); a local
# `npm install` writes one that must not be committed.
package-lock.json

# Bundler smoke tests (test/bundlers): installed tools and build output, never committed
test/bundlers/node_modules/
test/bundlers/out/
